  "scripts": {
    "start": "env-cmd -f .env.local vite --host 0.0.0.0",
    "build:local": "env-cmd -f .env.local vite build",
    "build:pso": "env-cmd -f .env.pso vite build",
    "start:pso": "env-cmd -f .env.pso vite --host 0.0.0.0",
    "build:uat": "env-cmd -f .env.uat vite build",
    "build:staging": "env-cmd -f .env.staging vite build",
    "build:optimize": "env-cmd -f .env.optimized vite build",
    "build:production": "env-cmd -f .env.production vite build",
    "preview": "vite preview --outDir build",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force node_modules -ErrorAction SilentlyContinue; npm cache clean --force;\""
