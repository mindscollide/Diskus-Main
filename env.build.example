# Copy to `.env.build` (git-ignored) on every machine that builds the app:
#   copy env.build.example .env.build
# These three values are the same in every environment, which is why they are
# still build-time. Everything that differs per deployment (URLs, feature flags,
# licence key) lives in runtime-config.js instead.
REACT_APP_SECERETKEY=
REACT_APP_MQTT_User=
REACT_APP_MQTT_Pass=
